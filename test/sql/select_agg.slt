1 60000
2 72000
3 65000
4 68000
null 55000
5 58000

query II
select Employees__002.DepartmentID, max(Employees__002.Salary) as maxSalary from Employees__002 GROUP BY Employees__002.DepartmentID;
----
1 62000
2 75000
3 70000
4 68000
null 59000
5 58000

query II
select Employees__002.DepartmentID, count() as count from Employees__002 GROUP BY Employees__002.DepartmentID;
