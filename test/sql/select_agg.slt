# name: test/sql/select_agg.slt
# description: agg tests
# group: [select]

statement ok
CREATE TABLE Departments__002(DepartmentID bigint PRIMARY KEY, DepartmentName string NOT NULL);

statement ok
CREATE TABLE Employees__002(EmployeeID bigint PRIMARY KEY, FirstName string NOT NULL, LastName string NOT NULL, DepartmentID bigint, Salary real);

statement ok
INSERT INTO Departments__002(DepartmentID, DepartmentName)
      VALUES (1, 'HR'), (2, 'IT'), (3, 'Finance'), (4, 'Marketing'), (5, 'Operations'), (6, 'Research');

statement ok
