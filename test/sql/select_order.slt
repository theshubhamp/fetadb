query ITTII
select Employees__003.EmployeeID, Employees__003.FirstName, Employees__003.LastName, Employees__003.DepartmentID, Employees__003.Salary
      FROM Employees__003
      ORDER BY Employees__003.departmentid DESC, Employees__003.salary ASC;
