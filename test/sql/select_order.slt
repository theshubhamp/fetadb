# name: test/sql/select_order.slt
# description: order tests
# group: [select]

statement ok
CREATE TABLE Departments__003(DepartmentID bigint PRIMARY KEY, DepartmentName string NOT NULL);

statement ok
CREATE TABLE Employees__003(EmployeeID bigint PRIMARY KEY, FirstName string NOT NULL, LastName string NOT NULL, DepartmentID bigint, Salary real);

statement ok
INSERT INTO Departments__003(DepartmentID, DepartmentName)
